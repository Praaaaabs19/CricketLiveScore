{
  "expo": {
    "name": "CricketLiveScore",
    "slug": "CricketLiveScore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/loading page (2).jpeg",
    "scheme": "cricketlivescore",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/loading page (2).jpeg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.atharvasawant0804.CricketLiveScore"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/loading page (1).jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a61f80b1-2909-4fab-8af7-6a6dc47ad7d2"
      }
    },
    "owner": ""
  }
}
